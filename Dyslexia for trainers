<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Supporting Adults with Dyslexia | PET-Xi CPD</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=DM+Serif+Display&display=swap');

  :root {
    --pink: #D51A80;
    --pink-light: #f5e6f0;
    --pink-mid: #e8a0c8;
    --dark: #1a1a2e;
    --mid: #4a4a6a;
    --light: #f8f7fc;
    --white: #ffffff;
    --success: #2d7a4f;
    --warning: #b85c00;
    --radius: 16px;
    --shadow: 0 4px 24px rgba(213,26,128,0.10);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--light);
    color: var(--dark);
    min-height: 100vh;
    font-size: 18px;
    line-height: 1.7;
    letter-spacing: 0.01em;
  }

  #progress-bar {
    position: fixed;
    top: 0; left: 0;
    height: 5px;
    background: var(--pink);
    width: 0%;
    transition: width 0.4s ease;
    z-index: 100;
  }

  header {
    background: var(--dark);
    padding: 18px 20px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .logo-mark {
    font-family: 'DM Serif Display', serif;
    color: var(--pink);
    font-size: 22px;
    letter-spacing: -0.5px;
  }

  .module-label {
    font-size: 12px;
    color: var(--pink-mid);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .step-counter {
    font-size: 13px;
    color: #888;
    font-weight: 500;
  }

  #screen-container {
    max-width: 680px;
    margin: 0 auto;
    padding: 28px 18px 120px;
  }

  .screen { display: none; animation: fadeUp 0.4s ease both; }
  .screen.active { display: block; }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .section-tag {
    display: inline-block;
    background: var(--pink);
    color: var(--white);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 20px;
    margin-bottom: 14px;
  }

  h1 {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(26px, 6vw, 36px);
    line-height: 1.2;
    color: var(--dark);
    margin-bottom: 16px;
  }

  h2 {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(22px, 5vw, 30px);
    line-height: 1.25;
    color: var(--dark);
    margin-bottom: 14px;
  }

  p { margin-bottom: 16px; color: var(--mid); }
  p:last-child { margin-bottom: 0; }

  .card {
    background: var(--white);
    border-radius: var(--radius);
    padding: 22px 20px;
    margin-bottom: 16px;
    box-shadow: var(--shadow);
    border-left: 4px solid var(--pink);
  }

  .card-plain {
    background: var(--white);
    border-radius: var(--radius);
    padding: 22px 20px;
    margin-bottom: 16px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  }

  .card-dark {
    background: var(--dark);
    border-radius: var(--radius);
    padding: 22px 20px;
    margin-bottom: 16px;
    color: var(--white);
  }

  .card-dark p { color: #c0b8d4; }

  .stat-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 16px;
  }

  .stat-box {
    background: var(--white);
    border-radius: var(--radius);
    padding: 18px 14px;
    text-align: center;
    box-shadow: var(--shadow);
  }

  .stat-number {
    font-family: 'DM Serif Display', serif;
    font-size: 32px;
    color: var(--pink);
    line-height: 1;
    margin-bottom: 6px;
  }

  .stat-label {
    font-size: 13px;
    color: var(--mid);
    line-height: 1.4;
  }

  .highlight {
    background: var(--pink-light);
    border-radius: var(--radius);
    padding: 18px 20px;
    margin-bottom: 16px;
    border-left: 4px solid var(--pink);
  }

  .highlight p { color: var(--dark); }

  .question-text {
    font-size: 19px;
    font-weight: 600;
    color: var(--dark);
    margin-bottom: 20px;
    line-height: 1.4;
  }

  .options { display: flex; flex-direction: column; gap: 12px; }

  .option-btn {
    background: var(--white);
    border: 2px solid #e0dcea;
    border-radius: 12px;
    padding: 16px 18px;
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    line-height: 1.5;
    color: var(--dark);
    cursor: pointer;
    text-align: left;
    transition: border-color 0.2s, background 0.2s, transform 0.1s;
    -webkit-tap-highlight-color: transparent;
  }

  .option-btn:hover:not(:disabled) {
    border-color: var(--pink);
    background: var(--pink-light);
    transform: translateX(3px);
  }

  .option-btn.correct {
    border-color: var(--success);
    background: #edf7f2;
    color: var(--success);
    font-weight: 600;
  }

  .option-btn.incorrect {
    border-color: #c0392b;
    background: #fdf0ef;
    color: #c0392b;
  }

  .option-btn.reveal-correct {
    border-color: var(--success);
    background: #edf7f2;
    opacity: 0.7;
  }

  .option-btn:disabled { cursor: default; }

  .feedback {
    display: none;
    border-radius: 12px;
    padding: 16px 18px;
    margin-top: 16px;
    font-size: 16px;
    line-height: 1.6;
  }

  .feedback.correct-fb {
    background: #edf7f2;
    border-left: 4px solid var(--success);
    color: var(--success);
  }

  .feedback.incorrect-fb {
    background: #fdf0ef;
    border-left: 4px solid #c0392b;
    color: #8b2015;
  }

  .feedback.show { display: block; animation: fadeUp 0.3s ease; }

  .scenario-box {
    background: var(--dark);
    border-radius: var(--radius);
    padding: 22px 20px;
    margin-bottom: 20px;
    position: relative;
    overflow: hidden;
  }

  .scenario-box::before {
    content: '';
    position: absolute;
    top: -30px; right: -30px;
    width: 100px; height: 100px;
    background: var(--pink);
    opacity: 0.15;
    border-radius: 50%;
  }

  .scenario-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pink-mid);
    margin-bottom: 10px;
  }

  .scenario-box p { color: #c0b8d4; margin-bottom: 0; }

  .reflection-input {
    width: 100%;
    border: 2px solid #e0dcea;
    border-radius: 12px;
    padding: 16px;
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: var(--dark);
    resize: vertical;
    min-height: 100px;
    transition: border-color 0.2s;
    background: var(--white);
  }

  .reflection-input:focus {
    outline: none;
    border-color: var(--pink);
  }

  .input-hint {
    font-size: 13px;
    color: #999;
    margin-top: 8px;
    margin-bottom: 0;
  }

  .strategy-item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 14px 0;
    border-bottom: 1px solid #f0eef8;
  }

  .strategy-item:last-child { border-bottom: none; }

  .strategy-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--pink-light);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }

  .strategy-text strong {
    display: block;
    font-size: 16px;
    color: var(--dark);
    margin-bottom: 3px;
  }

  .strategy-text span {
    font-size: 14px;
    color: var(--mid);
    line-height: 1.5;
  }

  .myth-card {
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 14px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  }

  .myth-header {
    padding: 12px 18px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .myth-header.myth { background: #f0e8e8; color: #8b2015; }
  .myth-header.fact { background: #e8f0ec; color: var(--success); }

  .myth-body {
    background: var(--white);
    padding: 14px 18px;
    font-size: 15px;
    color: var(--mid);
    line-height: 1.6;
  }

  .checklist-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 12px 0;
    border-bottom: 1px solid #f0eef8;
  }

  .checklist-item:last-child { border-bottom: none; }

  .check-icon {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--pink);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .checklist-item p { margin: 0; font-size: 15px; color: var(--mid); }

  .nav-wrapper {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    z-index: 50;
  }

  .nav-inner {
    max-width: 680px;
    margin: 0 auto;
    background: var(--white);
    border-top: 1px solid #e8e4f4;
    padding: 14px 18px;
    display: flex;
    gap: 10px;
  }

  .btn-primary {
    flex: 1;
    background: var(--pink);
    color: var(--white);
    border: none;
    border-radius: 12px;
    padding: 16px;
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
    -webkit-tap-highlight-color: transparent;
  }

  .btn-primary:hover { background: #b8166d; }
  .btn-primary:active { transform: scale(0.98); }
  .btn-primary:disabled { background: #ccc; cursor: default; }

  .btn-secondary {
    background: var(--light);
    color: var(--mid);
    border: 2px solid #e0dcea;
    border-radius: 12px;
    padding: 16px 20px;
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s;
    -webkit-tap-highlight-color: transparent;
  }

  .btn-secondary:hover { background: #ede8f8; }

  .completion-circle {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: var(--pink);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
    font-size: 40px;
    animation: popIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
  }

  @keyframes popIn {
    from { transform: scale(0); opacity: 0; }
    to   { transform: scale(1); opacity: 1; }
  }

  .score-display { text-align: center; margin-bottom: 24px; }

  .score-number {
    font-family: 'DM Serif Display', serif;
    font-size: 52px;
    color: var(--pink);
    line-height: 1;
  }

  .score-label { font-size: 15px; color: var(--mid); }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    border: 0;
  }

  :focus-visible { outline: 3px solid var(--pink); outline-offset: 3px; }

  @media (max-width: 400px) {
    body { font-size: 17px; }
    .stat-number { font-size: 28px; }
  }
</style>
</head>
<body>

<div id="progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Module progress"></div>

<header>
  <div>
    <div class="logo-mark">PET-Xi</div>
    <div class="module-label">Trainer CPD</div>
  </div>
  <div class="step-counter" id="step-counter" aria-live="polite">1 of 9</div>
</header>

<main id="screen-container" role="main">

  <section class="screen active" id="screen-1" aria-label="Prior knowledge check">
    <div class="section-tag">Before we start</div>
    <h1>What do you already know?</h1>
    <p>Think about a learner you've worked with recently who found reading or writing difficult.</p>
    <div class="card-plain">
      <p class="question-text">In your experience, what's the most common reason a learner struggles to read instructions during a session?</p>
      <div class="options" role="group" aria-label="Select your answer">
        <button class="option-btn" onclick="handlePrior(this, false)" aria-pressed="false">They haven't tried hard enough</button>
        <button class="option-btn" onclick="handlePrior(this, false)" aria-pressed="false">They didn't pay attention in school</button>
        <button class="option-btn" onclick="handlePrior(this, true)" aria-pressed="false">They may have an unidentified learning difficulty</button>
        <button class="option-btn" onclick="handlePrior(this, false)" aria-pressed="false">They're not motivated</button>
      </div>
      <div class="feedback" id="prior-fb" role="alert"></div>
    </div>
    <div class="highlight">
      <p>Around 1 in 5 of your learners is likely to have some form of literacy difficulty — many will never have been diagnosed.</p>
    </div>
  </section>

  <section class="screen" id="screen-2" aria-label="What is dyslexia">
    <div class="section-tag">The concept</div>
    <h2>What is dyslexia — and what it isn't</h2>
    <div class="card-dark">
      <p style="color:#fff; font-weight:500; margin-bottom:8px;">The definition</p>
      <p>Dyslexia is a specific learning difficulty that affects accurate and fluent reading, spelling and written expression. It is neurological in origin and occurs across the full range of intellectual abilities.</p>
      <p style="margin-top:10px; color: #e8a0c8; font-weight:500;">It is a lifelong condition — not a sign of low intelligence.</p>
    </div>
    <div class="stat-row">
      <div class="stat-box"><div class="stat-number">~10%</div><div class="stat-label">of the UK population are dyslexic</div></div>
      <div class="stat-box"><div class="stat-number">~4%</div><div class="stat-label">are severely affected</div></div>
      <div class="stat-box"><div class="stat-number">Many</div><div class="stat-label">adults reach training undiagnosed</div></div>
      <div class="stat-box"><div class="stat-number">2010</div><div class="stat-label">Equality Act — dyslexia is a recognised disability</div></div>
    </div>
    <div class="card-plain">
      <div class="myth-card">
        <div class="myth-header myth">✗ Myth</div>
        <div class="myth-body">Dyslexia is just about reading slowly or getting letters the wrong way round.</div>
      </div>
      <div class="myth-card">
        <div class="myth-header fact">✓ Fact</div>
        <div class="myth-body">Dyslexia affects processing speed, working memory, phonological awareness and organisation — not just reading. Many adults are highly able in verbal reasoning and creativity.</div>
      </div>
    </div>
    <p style="font-size:13px; color:#aaa;">Source: British Dyslexia Association / Rose Report 2009</p>
  </section>

  <section class="screen" id="screen-3" aria-label="How adults present differently">
    <div class="section-tag">The concept</div>
    <h2>How adults present differently</h2>
    <div class="highlight">
      <p>Adult dyslexia is often missed because learners have spent decades developing coping strategies. By the time they reach your session, the dyslexia may be invisible — but the impact isn't.</p>
    </div>
    <div class="card-plain">
      <div class="strategy-item">
        <div class="strategy-icon">🗣️</div>
        <div class="strategy-text"><strong>Avoidance</strong><span>Talking a lot to avoid being asked to read aloud, or volunteering for physical tasks instead of written ones.</span></div>
      </div>
      <div class="strategy-item">
        <div class="strategy-icon">⏱️</div>
        <div class="strategy-text"><strong>Slow completion</strong><span>Taking significantly longer with written tasks, or leaving them unfinished and offering other reasons.</span></div>
      </div>
      <div class="strategy-item">
        <div class="strategy-icon">😤</div>
        <div class="strategy-text"><strong>Frustration or disengagement</strong><span>Behaviour that looks like attitude is often shame or anxiety about being exposed.</span></div>
      </div>
      <div class="strategy-item">
        <div class="strategy-icon">🧠</div>
        <div class="strategy-text"><strong>Strong verbal ability</strong><span>Articulate in discussion but written work looks inconsistent. A gap between spoken and written performance is a key indicator.</span></div>
      </div>
      <div class="strategy-item">
        <div class="strategy-icon">📋</div>
        <div class="strategy-text"><strong>Copying errors</strong><span>Miscopying from boards or handouts — not because of poor eyesight but because of working memory load.</span></div>
      </div>
    </div>
  </section>

  <section class="screen" id="screen-4" aria-label="Worked example">
    <div class="section-tag">Worked example</div>
    <h2>Marcus — what you might see</h2>
    <div class="scenario-box">
      <div class="scenario-label">Learner profile</div>
      <p>Marcus is 28 and on a Restart programme. He's confident in group discussions, contributes good ideas, and has strong practical skills from his previous job in logistics.</p>
      <p style="margin-top:12px;">When you give out a written activity, Marcus goes quiet. He takes his sheet but doesn't start. After 10 minutes he says he's "not bothered" and puts it face down.</p>
    </div>
    <div class="card-plain">
      <p style="font-weight:600; color:var(--dark); margin-bottom:10px;">What's likely happening</p>
      <p>Marcus can't process the written task quickly enough to keep up with the group. The fear of being seen to struggle — after years of hiding it — is greater than the task itself. "Not bothered" is protective.</p>
    </div>
    <div class="highlight">
      <p style="font-weight:600; color:var(--dark); margin-bottom:8px;">What a good trainer does</p>
      <p>Doesn't push. Quietly offers to talk through the activity verbally first, or pair Marcus with someone. Doesn't draw attention. Notes the pattern for a private conversation later.</p>
    </div>
  </section>

  <section class="screen" id="screen-5" aria-label="Knowledge check question 1">
    <div class="section-tag">Knowledge check</div>
    <h2>Let's check your understanding</h2>
    <div class="card-plain">
      <p class="question-text">A learner consistently avoids written tasks but contributes confidently in group discussion. What should you consider first?</p>
      <div class="options" role="group" aria-label="Select your answer">
        <button class="option-btn" onclick="handleMCQ(this, false, 'q1')" aria-pressed="false">They need to improve their attitude to written work</button>
        <button class="option-btn" onclick="handleMCQ(this, true, 'q1')" aria-pressed="false">There may be an unidentified literacy difficulty such as dyslexia</button>
        <button class="option-btn" onclick="handleMCQ(this, false, 'q1')" aria-pressed="false">Their verbal skills are masking low overall ability</button>
        <button class="option-btn" onclick="handleMCQ(this, false, 'q1')" aria-pressed="false">They haven't engaged with learning since school</button>
      </div>
      <div class="feedback" id="q1-fb" role="alert"></div>
    </div>
  </section>

  <section class="screen" id="screen-6" aria-label="Practical strategies">
    <div class="section-tag">What you can do</div>
    <h2>Practical strategies for your sessions</h2>
    <p>These don't require any specialist training — they are reasonable adjustments that benefit all learners, not just those with dyslexia.</p>
    <div class="card-plain">
      <div class="strategy-item">
        <div class="strategy-icon">🔤</div>
        <div class="strategy-text"><strong>Font and layout</strong><span>Use sans-serif fonts (Arial, Calibri) at minimum 14pt. Left-align text. Never justify. Use generous line spacing.</span></div>
      </div>
      <div class="strategy-item">
        <div class="strategy-icon">🎨</div>
        <div class="strategy-text"><strong>Coloured backgrounds</strong><span>Offer cream or pastel alternatives to white paper. White with black text creates high contrast glare for some dyslexic learners.</span></div>
      </div>
      <div class="strategy-item">
        <div class="strategy-icon">🔊</div>
        <div class="strategy-text"><strong>Give instructions verbally first</strong><span>Say it, then write it. Don't rely on learners reading from the board or handout as their primary source.</span></div>
      </div>
      <div class="strategy-item">
        <div class="strategy-icon">⏰</div>
        <div class="strategy-text"><strong>Extended time without fuss</strong><span>Build extra processing time into activities for everyone — you don't need to single anyone out.</span></div>
      </div>
      <div class="strategy-item">
        <div class="strategy-icon">🎤</div>
        <div class="strategy-text"><strong>Alternative ways to respond</strong><span>Verbal responses, recording answers on a phone, drawing, or completing with a partner all count. Reduce the barrier, not the expectation.</span></div>
      </div>
      <div class="strategy-item">
        <div class="strategy-icon">🧩</div>
        <div class="strategy-text"><strong>Chunk and sequence</strong><span>Break activities into small steps. Give one instruction at a time. Don't overload working memory.</span></div>
      </div>
    </div>
  </section>

  <section class="screen" id="screen-7" aria-label="Challenge scenario">
    <div class="section-tag">Your turn — think it through</div>
    <h2>A genuine challenge</h2>
    <div class="scenario-box">
      <div class="scenario-label">Scenario</div>
      <p>You're running a CV writing session. You've given out a worksheet with six sections to complete. Priya, 34, fills in her name and stops. She starts chatting to the person next to her. When you go over she says "I already know how to do a CV, I've had loads of jobs."</p>
    </div>
    <div class="card-plain">
      <p class="question-text">What is the most appropriate immediate response?</p>
      <div class="options" role="group" aria-label="Select your answer">
        <button class="option-btn" onclick="handleMCQ(this, false, 'q2')" aria-pressed="false">Explain that everyone needs to complete the worksheet regardless of experience</button>
        <button class="option-btn" onclick="handleMCQ(this, false, 'q2')" aria-pressed="false">Ask her to be quiet and let others focus</button>
        <button class="option-btn" onclick="handleMCQ(this, true, 'q2')" aria-pressed="false">Acknowledge her experience, then sit alongside her and offer to talk through one section at a time</button>
        <button class="option-btn" onclick="handleMCQ(this, false, 'q2')" aria-pressed="false">Let her opt out since she has prior experience</button>
      </div>
      <div class="feedback" id="q2-fb" role="alert"></div>
    </div>
  </section>

  <section class="screen" id="screen-8" aria-label="Reflection and practice connection">
    <div class="section-tag">Reflection</div>
    <h2>What will you do on Monday?</h2>
    <div class="highlight">
      <p>The strongest predictor of whether CPD changes anything is whether you connect it to a specific action in your next session.</p>
    </div>
    <div class="card-plain">
      <p style="font-weight:600; color:var(--dark); margin-bottom:12px;">Think about your next session. Write one thing you'll do differently to support a learner who may have an unidentified literacy difficulty.</p>
      <textarea class="reflection-input" id="reflection-text" placeholder="For example: I'll offer to go through written tasks verbally with anyone who seems stuck, before assuming it's an attitude issue..." aria-label="Your reflection" rows="4"></textarea>
      <p class="input-hint">There's no right answer. This is for you — your trainer will see a summary.</p>
    </div>
    <div class="card-dark">
      <p style="color:#e8a0c8; font-weight:600; margin-bottom:8px;">Key reminder</p>
      <p>You don't need to diagnose anyone. Your role is to notice patterns, reduce barriers, and refer to your SENCO or pastoral lead when a learner may benefit from a formal assessment.</p>
    </div>
  </section>

  <section class="screen" id="screen-9" aria-label="Summary and completion">
    <div class="completion-circle" aria-hidden="true">✓</div>
    <div class="score-display">
      <div class="score-number" id="final-score">0/2</div>
      <div class="score-label">knowledge check questions correct</div>
    </div>
    <h2 style="text-align:center; margin-bottom:20px;">The one thing to remember</h2>
    <div class="card" style="border-left-color: var(--pink);">
      <p style="color:var(--dark); font-weight:500;">A gap between verbal ability and written performance is your clearest signal. When you see it, don't assume attitude — assume barrier.</p>
    </div>
    <div class="card-plain">
      <p style="font-weight:600; color:var(--dark); margin-bottom:14px;">Today's key points</p>
      <div class="checklist-item"><div class="check-icon" aria-hidden="true">✓</div><p>Dyslexia affects ~10% of learners and is a recognised disability under the Equality Act</p></div>
      <div class="checklist-item"><div class="check-icon" aria-hidden="true">✓</div><p>Adults often hide it well — avoidance, frustration and slow completion are common signs</p></div>
      <div class="checklist-item"><div class="check-icon" aria-hidden="true">✓</div><p>Practical adjustments benefit everyone, not just those with dyslexia</p></div>
      <div class="checklist-item"><div class="check-icon" aria-hidden="true">✓</div><p>Your role is to notice and reduce barriers — not to diagnose</p></div>
      <div class="checklist-item"><div class="check-icon" aria-hidden="true">✓</div><p>Refer to your SENCO or pastoral lead when you think a formal assessment would help</p></div>
    </div>
    <div class="highlight" style="margin-top:8px;">
      <p style="font-size:14px; color:var(--mid);">You'll receive a short follow-up question in 48 hours. It takes two minutes and helps the learning stick.</p>
    </div>
  </section>

</main>

<div class="nav-wrapper" role="navigation" aria-label="Module navigation">
  <div class="nav-inner">
    <button class="btn-secondary" id="btn-back" onclick="navigate(-1)" aria-label="Go to previous screen" style="display:none;">← Back</button>
    <button class="btn-primary" id="btn-next" onclick="navigate(1)" aria-label="Go to next screen">Continue</button>
  </div>
</div>

<script>
  let currentScreen = 1;
  const totalScreens = 9;
  let scores = { prior: false, q1: false, q2: false };
  let answeredScreens = {};

  function navigate(dir) {
    const questionScreens = { 1: 'prior', 5: 'q1', 7: 'q2' };
    if (dir === 1 && questionScreens[currentScreen] && !answeredScreens[currentScreen]) return;
    const prev = document.getElementById('screen-' + currentScreen);
    currentScreen = Math.max(1, Math.min(totalScreens, currentScreen + dir));
    const next = document.getElementById('screen-' + currentScreen);
    prev.classList.remove('active');
    next.classList.add('active');
    updateUI();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function updateUI() {
    const pct = ((currentScreen - 1) / (totalScreens - 1)) * 100;
    const bar = document.getElementById('progress-bar');
    bar.style.width = pct + '%';
    bar.setAttribute('aria-valuenow', Math.round(pct));
    document.getElementById('step-counter').textContent = currentScreen + ' of ' + totalScreens;
    const btnBack = document.getElementById('btn-back');
    const btnNext = document.getElementById('btn-next');
    btnBack.style.display = currentScreen > 1 ? 'block' : 'none';
    if (currentScreen === totalScreens) {
      btnNext.textContent = 'Done ✓';
      btnNext.disabled = false;
      const correct = (scores.q1 ? 1 : 0) + (scores.q2 ? 1 : 0);
      document.getElementById('final-score').textContent = correct + '/2';
    } else {
      btnNext.textContent = 'Continue';
      const questionScreens = [1, 5, 7];
      btnNext.style.opacity = (questionScreens.includes(currentScreen) && !answeredScreens[currentScreen]) ? '0.5' : '1';
    }
  }

  function handlePrior(btn, isCorrect) {
    if (answeredScreens[1]) return;
    answeredScreens[1] = true;
    const parent = btn.closest('.options');
    parent.querySelectorAll('.option-btn').forEach(b => {
      b.disabled = true;
      if (b === btn && isCorrect) b.classList.add('correct');
      else if (b === btn && !isCorrect) b.classList.add('incorrect');
    });
    if (!isCorrect) {
      parent.querySelectorAll('.option-btn').forEach(b => {
        if (b.textContent.includes('unidentified learning difficulty')) b.classList.add('reveal-correct');
      });
    }
    const fb = document.getElementById('prior-fb');
    fb.classList.add('show');
    if (isCorrect) {
      fb.classList.add('correct-fb');
      fb.innerHTML = '&#10003; Good instinct. Unidentified learning difficulties — including dyslexia — are one of the most common reasons adults disengage from written tasks.';
    } else {
      fb.classList.add('incorrect-fb');
      fb.innerHTML = 'The most likely explanation is an unidentified learning difficulty. Learners who struggle have often had years of being told they\'re lazy or unmotivated — that\'s rarely the real story.';
    }
    document.getElementById('btn-next').style.opacity = '1';
  }

  function handleMCQ(btn, isCorrect, qid) {
    const screenMap = { q1: 5, q2: 7 };
    const screenNum = screenMap[qid];
    if (answeredScreens[screenNum]) return;
    answeredScreens[screenNum] = true;
    scores[qid] = isCorrect;
    const parent = btn.closest('.options');
    parent.querySelectorAll('.option-btn').forEach(b => {
      b.disabled = true;
      if (b === btn && isCorrect) b.classList.add('correct');
      else if (b === btn && !isCorrect) b.classList.add('incorrect');
    });
    if (!isCorrect) {
      parent.querySelectorAll('.option-btn').forEach(b => {
        if ((qid === 'q1' && b.textContent.includes('unidentified literacy difficulty')) ||
            (qid === 'q2' && b.textContent.includes('sit alongside'))) {
          b.classList.add('reveal-correct');
        }
      });
    }
    const fb = document.getElementById(qid + '-fb');
    fb.classList.add('show');
    const feedback = {
      q1: {
        correct: '&#10003; Exactly right. A strong gap between verbal and written performance is your clearest indicator of a possible literacy difficulty. Assume barrier before assuming attitude.',
        incorrect: 'The most important first consideration is whether there\'s an unidentified literacy difficulty. A learner who is articulate in discussion but avoids written tasks is showing a classic pattern worth noting.'
      },
      q2: {
        correct: '&#10003; Right approach. Acknowledging her experience validates her, and sitting alongside removes the public exposure that\'s often the real barrier. You\'re reducing the threat, not the expectation.',
        incorrect: 'The best response acknowledges her experience (which may be genuine) and removes the public pressure of the written task. Sitting alongside and talking through it gives her a private, low-threat way in.'
      }
    };
    if (isCorrect) {
      fb.classList.add('correct-fb');
      fb.innerHTML = feedback[qid].correct;
    } else {
      fb.classList.add('incorrect-fb');
      fb.innerHTML = feedback[qid].incorrect;
    }
    document.getElementById('btn-next').style.opacity = '1';
  }

  updateUI();
</script>
</body>
</html>
